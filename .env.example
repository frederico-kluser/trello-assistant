# ═══════════════════════════════════════════════════════════════
#  Trello Orbit — variáveis de ambiente
#  Copie para .env  (cp .env.example .env) e preencha.
#  O .env está no .gitignore e NUNCA deve ser commitado.
#  Nada aqui vai para o navegador: tudo é lido só pelo servidor.
# ═══════════════════════════════════════════════════════════════

# ── Servidor ────────────────────────────────────────────────────
PORT=8787
# URL pública do app (usada só como header de atribuição no OpenRouter)
APP_URL=http://localhost:8787
APP_NAME=Trello Orbit

# ── OpenAI — transcrição de voz (STT) ───────────────────────────
# Crie em: https://platform.openai.com/api-keys
# (sem crédito? deixe vazio — o app cai no reconhecimento do navegador)
OPENAI_API_KEY=
# Modelos: gpt-4o-mini-transcribe (barato) | gpt-4o-transcribe | whisper-1
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_STT_LANGUAGE=pt

# ── OpenRouter — JEV decide + Gemini (comandos compostos) ────────
# Crie em: https://openrouter.ai/keys  ·  a mesma chave serve aos dois modelos.
OPENROUTER_API_KEY=
# System Two: planeja COMANDOS COMPOSTOS (várias ações numa fala) e, no futuro,
# gera texto (nome/descrição/motivações) em criar/editar. Não é fallback do JEV.
OPENROUTER_MODEL=google/gemini-3.8-flash
# Esforço de raciocínio: max | xhigh | high | medium | low | minimal | none
# (aplica-se ao Gemini no planejamento de comandos compostos).
OPENROUTER_REASONING_EFFORT=max
# Teto de tokens de saída (inclui os reasoning tokens, cobrados como output).
OPENROUTER_MAX_TOKENS=16000
# Teto de custo por milhão de tokens (segurança extra; vazio = sem teto)
OPENROUTER_MAX_PROMPT_PRICE=
OPENROUTER_MAX_COMPLETION_PRICE=

# ── JEV (TypeSafe "System One") — todas as classificações ─────────
# Fase 1 decide intenção (CRUD), card, lista e as colunas; consultas de
# listagem seguem a cascata colunas → cards em lotes. Sem fallback de LLM:
# abstenção = pedir esclarecimento. Ver docs/PIPELINE-JEV.md.
# false = desliga e o app usa o interpretador local pt-BR (modo sem chaves).
JEV_ENABLED=true
JEV_MODEL=typesafe/jev-1.13
# Bandas de confiança (ações de CRUD): auto >= AUTO · pede ok >= HITL ·
# abaixo disso o JEV se abstém. Criar/apagar confirmam sempre.
JEV_AUTO_THRESHOLD=0.80
JEV_HITL_THRESHOLD=0.50
# Cascata de listagem: cards avaliados por chamada (4–24; 1 pergunta
# "deve ser listado?" por card, pointwise).
JEV_CARD_BATCH=16
# p >= INCLUDE → card listado · p >= MAYBE → listado com ressalva "talvez"
# (recall-first: nunca se esconde um card por incerteza).
JEV_LIST_INCLUDE=0.5
JEV_LIST_MAYBE=0.35
# Portão de colunas: p >= isto para a coluna passar (critério largo; a poda é
# pulada em consultas de prazo/semana e em boards pequenos, e se nenhuma
# coluna passar, passam todas — recall-first).
JEV_COL_INCLUDE=0.35
# Timeout de cada decisão (uma decisão normal leva ~400 ms).
JEV_TIMEOUT_MS=4000

# ── Trello — API REST v1 ────────────────────────────────────────
# Passo a passo: docs/PROXIMOS-PASSOS.html
# 1) Key:   https://trello.com/power-ups/admin  → "API Key" → Generate
# 2) Token: https://trello.com/1/authorize?expiration=never&scope=read,write&response_type=token&key=SUA_KEY
# 3) Board: abra o board no navegador → ?idBoard=... ou use /api/trello/boards
TRELLO_API_KEY=
TRELLO_API_TOKEN=
TRELLO_BOARD_ID=