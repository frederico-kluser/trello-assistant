# ═══════════════════════════════════════════════════════════════
#  Trello Orbit — variáveis de ambiente
#  Copie para .env  (cp .env.example .env) e preencha.
#  O .env está no .gitignore e NUNCA deve ser commitado.
#  Nada aqui vai para o navegador: tudo é lido só pelo servidor.
# ═══════════════════════════════════════════════════════════════

# ── Servidor ────────────────────────────────────────────────────
PORT=8787
# URL pública do app (usada só como header de atribuição no OpenRouter)
APP_URL=http://localhost:8787
APP_NAME=Trello Orbit

# ── OpenAI — transcrição de voz (STT) ───────────────────────────
# Crie em: https://platform.openai.com/api-keys
# (sem crédito? deixe vazio — o app cai no reconhecimento do navegador)
OPENAI_API_KEY=
# Modelos: gpt-4o-mini-transcribe (barato) | gpt-4o-transcribe | whisper-1
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_STT_LANGUAGE=pt

# ── OpenRouter — JEV (classifica) + MiMo 2.6 Pro (reserva) ───────
# Crie em: https://openrouter.ai/keys  ·  UMA chave serve aos dois modelos.
OPENROUTER_API_KEY=
# Modelo de RESERVA: só entra quando o JEV se abstém ou está indisponível.
OPENROUTER_MODEL=xiaomi/mimo-v2.6-pro
# Esforço de raciocínio: max | xhigh | high | medium | low | minimal | none
# Padrão "max" — o MiMo pensa o MÁXIMO antes de devolver o plano de ações.
OPENROUTER_REASONING_EFFORT=max
# Teto de tokens de saída (inclui os reasoning tokens, cobrados como output).
OPENROUTER_MAX_TOKENS=16000
# Teto de custo por milhão de tokens (segurança extra; vazio = sem teto)
OPENROUTER_MAX_PROMPT_PRICE=
OPENROUTER_MAX_COMPLETION_PRICE=

# ── JEV (TypeSafe "System One") — todas as classificações ─────────
# Decide intenção, card e lista em ~0,4 s (US$ 0,042 por 1M tokens de entrada).
# false = desliga e manda tudo direto para o MiMo.
JEV_ENABLED=true
JEV_MODEL=typesafe/jev-1.13
# Bandas de confiança: auto >= AUTO · pede ok >= HITL · abaixo disso o JEV se abstém.
JEV_AUTO_THRESHOLD=0.80
JEV_HITL_THRESHOLD=0.50
# Passou disto, cai no MiMo (uma decisão normal leva ~400 ms).
JEV_TIMEOUT_MS=4000

# ── Trello — API REST v1 ────────────────────────────────────────
# Passo a passo: docs/PROXIMOS-PASSOS.html
# 1) Key:   https://trello.com/power-ups/admin  → "API Key" → Generate
# 2) Token: https://trello.com/1/authorize?expiration=never&scope=read,write&response_type=token&key=SUA_KEY
# 3) Board: abra o board no navegador → ?idBoard=... ou use /api/trello/boards
TRELLO_API_KEY=
TRELLO_API_TOKEN=
TRELLO_BOARD_ID=